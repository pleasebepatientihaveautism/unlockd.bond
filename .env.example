NODE_ENV=development
PORT=3000
# demo | hedera-demo (synthetic evaluation + real Testnet settlement) | live
APP_MODE=demo
PUBLIC_BASE_URL=http://localhost:5173
# Production hosting URL: https://unlockd.bond
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=postgresql://unlockd_bond:local-development-only@localhost:5432/unlockd_bond
DATABASE_SSL=false
COMMITMENT_SECRET=replace-with-at-least-32-random-characters
CONFIRMATION_SECRET=replace-with-a-different-32-character-secret

# Live mode: The Graph
GRAPH_ENDPOINT=
GRAPH_API_KEY=
GRAPH_ASSET_ID=AAPL
GRAPH_MAX_AGE_SECONDS=180
GRAPH_MIN_SAMPLES=2

# Live mode: 0G private TeeML
ZEROG_API_KEY=
ZEROG_MODEL=0gm-1.0-35b-a3b
ZEROG_ROUTER_URL=https://router-api.0g.ai

# Live mode: Hedera testnet
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TREASURY_ID=
HEDERA_TREASURY_KEY=
HEDERA_SUPPLY_KEY=
HEDERA_POOL_ID=
# Provisioning only; never provide this to the application runtime.
HEDERA_POOL_KEY=
HEDERA_TOPIC_ID=
HEDERA_TOKEN_ID=
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
PAYOUT_TINYBAR_PER_USD_MINOR=10000

# Demo policy limits (USD minor units / cents)
POLICY_FIXED_CAP_MINOR=200000
TREASURY_RESERVE_TINYBAR=100000000
